# Copy to .env (never commit .env). Real environment variables override this file.

# Google AI Studio -> Get API key (free tier, works from Ethiopia)
GEMINI_API_KEY=
# Model names change often: `python -m pipeline.smoke` lists the ones your key can see.
GEMINI_TEXT_MODEL=gemini-flash-lite-latest
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Cloudflare dashboard -> AI -> Workers AI -> "Use REST API" (token needs Workers AI: Read)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# @cf/black-forest-labs/flux-1-schnell (text only) or a FLUX.2 model id (uses the reference sheet as an input image)
KEYFRAME_MODEL=@cf/black-forest-labs/flux-2-klein-9b
KEYFRAME_STEPS=8

# Wan 2.2 settings baked into each Kaggle job (these are part of the clip cache key)
WAN_MODEL=Wan-AI/Wan2.2-TI2V-5B-Diffusers
WAN_SIZE=832*480
WAN_FRAMES=121
WAN_STEPS=30
WAN_GUIDANCE=5.0

# Kaggle (GPU stages): kaggle.com -> Settings -> API -> Generate New Token
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=
